{
  "name": "efreipara",
  "version": "1.15.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "PW_SLOWMO=400 playwright test --headed --workers=1",
    "test:all": "bun run generate && bun run test && bun run test:e2e",
    "cdn:build": "bun scripts/cdn-build.ts",
    "docker:build": "set -a && . ./.env && set +a && docker build --build-arg CDN_URL --build-arg PLAUSIBLE_URL --build-arg PLAUSIBLE_DOMAIN -t efreipara ."
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "//typescript": "typescript bloqué en 6.0.x : typescript-eslint ne supporte pas encore TS 7.",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/tabler": "^1.2.42",
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.1.0",
    "@nuxt/icon": "^2.6.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/plausible": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  }
}
