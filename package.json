{
  "name": "efreipara",
  "version": "1.17.6",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "bun tests/e2e/serve.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "PW_SLOWMO=400 playwright test --headed --workers=1",
    "test:all": "bun run generate && bun run test && bun run test:e2e",
    "goals": "UPDATE_GOALS=1 playwright test goals --project=desktop",
    "cdn:build": "bun scripts/cdn-build.ts",
    "docker:build": "set -a && . ./.env && set +a && docker build --build-arg CDN_URL --build-arg PLAUSIBLE_URL --build-arg PLAUSIBLE_DOMAIN -t efreipara ."
  },
  "dependencies": {
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "//typescript": "typescript bloqué en 6.0.x : typescript-eslint ne supporte pas encore TS 7.",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify-json/tabler": "^1.2.46",
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "^3.17.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/plausible": "^4.1.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "nuxt": "^4.6.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
