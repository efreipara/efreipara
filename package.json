  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/tabler": "^1.2.41",
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "^3.16.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/plausible": "^4.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
